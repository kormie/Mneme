def kernel() -> K.Kernel:
  K.Kernel{
    "mneme.spec/0.10",
    [
      K.Layer{"sensory", ["adapters", "buffer", "tools"], ["pg-s2w", "pg-twin"]},
      K.Layer{"working", ["slots", "scratch", "task"], ["pg-s2w", "pg-w2l", "pg-core", "pg-twin"]},
      K.Layer{"longterm", ["episodic", "semantic", "skills", "structural", "decisions", "lineage"], ["pg-w2l", "pg-dem", "pg-adl", "pg-core", "pg-audit"]},
      K.Layer{"core", ["values", "goals", "style", "caps", "self"], ["pg-core", "pg-s2w", "pg-w2l", "pg-twin", "pg-dem", "pg-adl", "pg-audit"]}
    ],
    [
      graph_pg_s2w(),
      graph_pg_w2l(),
      graph_pg_core(),
      graph_pg_dem(),
      graph_pg_adl(),
      graph_pg_twin(),
      graph_pg_audit()
    ],
    [
      K.Twin{"soma", K.Seed{}},
      K.Twin{"agora", K.Seed{}},
      K.Twin{"oikos", K.Seed{}},
      K.Twin{"nomos", K.Seed{}}
    ],
    ["validate", "holdout", "cut-class", "structural", "archive", "audit-heuristics", "sample-clean"]
  }
